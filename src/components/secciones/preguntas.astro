---
// Preguntas frecuentes sobre crema: el titular a la izquierda y, a la derecha, un acordeón nativo <details> (filetes,
// pregunta en serif, botón en hoja ocre con + / −), sin JavaScript. Campos: `preguntas[]` (pregunta, respuesta).
// Sin preguntas no se pinta. También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} banda="crema">
      <div class="grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-24">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
        <div class="faq-lista">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true" />
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .faq-lista { border-top: 2px solid var(--c-texto); }
  .faq { border-bottom: 1px solid var(--linea); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; min-height: 2.75rem; padding-block: 1.4rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-pregunta { font-family: var(--fuente-titulos); font-weight: 600; font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.3; }
  .faq-signo { position: relative; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: 0 1.4rem 0 1.4rem; background: var(--salvia); }
  .faq-signo::before, .faq-signo::after { content: ""; position: absolute; left: 50%; top: 50%; width: 1rem; height: 2px; background: var(--oliva); transform: translate(-50%, -50%); transition: transform .25s ease; }
  .faq-signo::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq[open] .faq-signo { background: var(--ocre); }
  .faq[open] .faq-signo::before, .faq[open] .faq-signo::after { background: var(--sobre-ocre); }
  .faq[open] .faq-signo::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-respuesta { max-width: 46rem; padding-bottom: 1.6rem; padding-right: 4rem; opacity: .88; }
  @media (max-width: 559px) { .faq-respuesta { padding-right: 0; } }
</style>
