---
// Portada a pantalla completa: la foto (jardín, casa) a sangre de borde a borde y, anclado abajo a la izquierda, un gran
// panel oliva con la esquina de arriba a la derecha redondeada en hoja: antetítulo, título enorme en serif cálida,
// entradilla, dos botones y `items` (titulo + icono) en dos columnas. En móvil, la foto arriba y el panel debajo,
// montado sobre ella. Sin foto, la portada es oliva plena. Sin `cta`, el botón principal llama por teléfono.
import { seccion, site, tel, nueva } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const principal = s?.cta?.url ? s.cta : c.telefono ? { texto: `Llamar al ${c.telefono}`, url: tel(c.telefono) } : null;
const secundario = s?.cta_secundario?.url ? s.cta_secundario : null;
const items = s?.items ?? [];
---

{
  s && (
    <section id={id} class:list={['portada', { 'portada--sin-foto': !s.imagen }]}>
      {s.imagen && (
        <div class="portada-foto">
          <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad={primera} />
        </div>
      )}
      <div class="portada-panel">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        <h1 class="portada-titulo">{s.titulo || site.nombre}</h1>
        {s.texto && <p class="portada-entradilla">{s.texto}</p>}
        {(principal || secundario) && (
          <div class="botones">
            {principal && <a class="btn" href={principal.url} {...nueva(principal.url)}>{principal.texto}</a>}
            {secundario && <a class="btn-sec" href={secundario.url} {...nueva(secundario.url)}>{secundario.texto}</a>}
          </div>
        )}
        {items.length > 0 && (
          <ul class="portada-datos">
            {items.slice(0, 6).map((it) => (
              <li>
                <Icono nombre={it.icono || 'check'} tam={22} />
                <span>{it.titulo}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
